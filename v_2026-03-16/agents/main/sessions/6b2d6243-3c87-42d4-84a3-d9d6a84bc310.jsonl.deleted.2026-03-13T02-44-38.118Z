DME.md\n/home/admin/.openclaw/workspace/todo-calendar/README.md\n/home/admin/.openclaw/workspace/todo-calendar/PRD.md\n/home/admin/.openclaw/workspace/todo-calendar/PROJECT_STATUS.md\n/home/admin/.openclaw/workspace/todo-calendar/backend/README.md\n/home/admin/.openclaw/workspace/todo-calendar/agent-score-system.md\n/home/admin/.openclaw/workspace/todo-calendar/design/DESIGN_SPEC.md\n/home/admin/.openclaw/workspace/todo-calendar/frontend/README.md","cwd":"/home/admin/.openclaw/workspace"},"isError":false,"timestamp":1773366252794}}
